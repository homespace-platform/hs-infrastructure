{
  "info": {
    "_postman_id": "9d537c3c-3af0-490d-b99d-ab7fdbd7652e",
    "name": "HomeSpace - VIETMAP Maps API (v4 + Logistics)",
    "description": "Collection tự tạo từ tài liệu chính thức VIETMAP ngày 08/10/2026. 11 endpoint đã đối chiếu. KHÔNG phải tất cả API được cấp quyền trong Trial. Chỉ chạy thủ công theo thứ tự, tránh Runner gây tốn quota. Các API cũ/deprecated, Tilemap SDK, batch và Isochrone (chưa công khai endpoint) không nằm trong collection; xem Postman collection chính thức https://www.postman.com/orange-escape-494916/workspace/vietmap-api-collection .",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Search & Geocoding v4 (HomeSpace)",
      "item": [
        {
          "name": "01 Autocomplete v4 - gợi ý khi nhập",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/autocomplete/v4?apikey={{apikey}}&text={{search_text}}&display_type=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "autocomplete",
                "v4"
              ],
              "query": [
                {
                  "key": "apikey",
                  "value": "{{apikey}}",
                  "description": "API key - giữ trong environment",
                  "disabled": false
                },
                {
                  "key": "text",
                  "value": "{{search_text}}",
                  "description": "",
                  "disabled": false
                },
                {
                  "key": "display_type",
                  "value": "5",
                  "description": "",
                  "disabled": false
                },
                {
                  "key": "focus",
                  "value": "{{focus}}",
                  "description": "Ưu tiên vị trí",
                  "disabled": true
                },
                {
                  "key": "cityId",
                  "value": "12",
                  "description": "Tùy chọn lọc thành phố",
                  "disabled": true
                },
                {
                  "key": "distId",
                  "value": "",
                  "description": "Tùy chọn",
                  "disabled": true
                },
                {
                  "key": "wardId",
                  "value": "",
                  "description": "Tùy chọn",
                  "disabled": true
                },
                {
                  "key": "circle_center",
                  "value": "",
                  "description": "Tùy chọn",
                  "disabled": true
                },
                {
                  "key": "circle_radius",
                  "value": "200",
                  "description": "Mét",
                  "disabled": true
                },
                {
                  "key": "cats",
                  "value": "",
                  "description": "Mã POI",
                  "disabled": true
                },
                {
                  "key": "layers",
                  "value": "ADDRESS",
                  "description": "Các giá trị POI/ADDRESS/VILLAGE/WARD/DIST/CITY/STREET",
                  "disabled": true
                },
                {
                  "key": "admin_new",
                  "value": "true",
                  "description": "Dùng với lọc đơn vị hành chính",
                  "disabled": true
                }
              ]
            },
            "description": "Dùng khi người dùng đang gõ. Kết quả tự lưu ref_id đầu tiên vào environment. https://maps.vietmap.vn/docs/map-api/autocomplete-version/autocomplete-v4/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status < 500\", function () { pm.expect(pm.response.code).to.be.below(500); });",
                  "if (pm.response.code === 200) {",
                  "  let data; try { data=pm.response.json(); } catch(e) {}",
                  "  if (Array.isArray(data) && data.length && data[0].ref_id) {",
                  "    pm.environment.set(\"ref_id\", data[0].ref_id);",
                  "    console.log(\"Saved ref_id for Place v4:\", data[0].ref_id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
