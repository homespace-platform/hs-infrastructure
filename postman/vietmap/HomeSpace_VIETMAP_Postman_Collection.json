              "path": [
                "api",
                "place",
                "v4"
              ],
              "query": [
                {
                  "key": "apikey",
                  "value": "{{apikey}}",
                  "description": "API key - giữ trong environment",
                  "disabled": false
                },
                {
                  "key": "refid",
                  "value": "{{ref_id}}",
                  "description": "",
                  "disabled": false
                }
              ]
            },
            "description": "Chạy Autocomplete/Geocode trước. https://maps.vietmap.vn/docs/map-api/place-v4/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status < 500\", function () { pm.expect(pm.response.code).to.be.below(500); });",
                  "if(pm.response.code === 200) {let d=pm.response.json(); if(typeof d.lat === \"number\") pm.environment.set(\"lat\",String(d.lat)); if(typeof d.lng === \"number\") pm.environment.set(\"lng\",String(d.lng));}"
                ]
              }
            }
          ]
        },
