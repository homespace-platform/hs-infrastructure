        {
          "name": "03 Place v4 - ref_id -> tọa độ",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/place/v4?apikey={{apikey}}&refid={{ref_id}}",
              "host": [
                "{{base_url}}"
